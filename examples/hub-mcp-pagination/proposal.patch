+
+from contextlib import asynccontextmanager
+
+import anyio
+import pytest
+from mcp import types
+from mcp.server.lowlevel import Server
+from mcp.shared.memory import create_client_server_memory_streams
+
+from huggingface_hub import MCPClient
+
+
+pytestmark = pytest.mark.inference
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    "pages,allowed_tools,expected_names",
+    [
+        ([["search_docs"]], None, ["search_docs"]),
+        ([["search_docs"], [], ["fetch_doc"]], None, ["search_docs", "fetch_doc"]),
+        ([["search_docs"], [], ["fetch_doc"]], ["fetch_doc"], ["fetch_doc"]),
+    ],
+)
+async def test_mcp_client_discovers_paginated_tools(monkeypatch, pages, allowed_tools, expected_names):
+    server = Server("paginated-tools")
+    requested_cursors = []
+
+    async def list_tools(request: types.ListToolsRequest) -> types.ServerResult:
+        cursor = request.params.cursor if request.params is not None else None
+        requested_cursors.append(cursor)
+        page_index = int(cursor) if cursor is not None else 0
+        return types.ServerResult(
+            types.ListToolsResult(
+                tools=[types.Tool(name=name, inputSchema={"type": "object"}) for name in pages[page_index]],
+                nextCursor=str(page_index + 1) if page_index + 1 < len(pages) else None,
+            )
+        )
+
+    server.request_handlers[types.ListToolsRequest] = list_tools
+
+    @asynccontextmanager
+    async def in_memory_stdio_client(_params):
+        async with create_client_server_memory_streams() as (client_streams, server_streams):
+            async with anyio.create_task_group() as task_group:
+                task_group.start_soon(server.run, *server_streams, server.create_initialization_options())
+                try:
+                    yield client_streams
+                finally:
+                    task_group.cancel_scope.cancel()
+
+    monkeypatch.setattr("mcp.client.stdio.stdio_client", in_memory_stdio_client)
+    with anyio.fail_after(5):
+        async with MCPClient(model="unused-offline-model") as client:
+            await client.add_mcp_server("stdio", command="unused", allowed_tools=allowed_tools)
+
+            assert [tool.function.name for tool in client.available_tools] == expected_names
+            assert list(client.sessions) == expected_names
+            assert requested_cursors == [None, *[str(index) for index in range(1, len(pages))]]
